# Copy to .env and fill in. DATABASE_URL and SESSION_SECRET are required.

# Postgres. Locally this is your own server; in production it is the connection
# string from Neon — use the pooled one, which has "-pooler" in the host.
DATABASE_URL=postgres://user:password@localhost:5432/book

# Signs the login cookie. Required and validated before any DB connection opens.
# Use at least 32 characters; `openssl rand -base64 32` is a good source.
SESSION_SECRET=

# Optional but recommended before enabling owner authenticator MFA. This encrypts
# TOTP secrets at rest. Keep it stable: changing it makes existing authenticator
# secrets unreadable. If unset, SESSION_SECRET is used as the encryption key.
MFA_ENCRYPTION_KEY=

# Phase 9 encrypted backups. This key is NOT interchangeable with a backup file:
# keep a copy somewhere separate. Changing or losing it makes old .afb files
# impossible to restore. Render's Blueprint generates and shares this value.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_EMAIL_BYTES=18874368
BACKUP_TO=
BACKUP_FROM=

# Restore safety. `npm run restore -- file.afb` only writes to this target.
# Keep it pointed at a disposable recovery database for drills. The restore tool
# refuses DATABASE_URL itself unless ALLOW_PRODUCTION_RESTORE=1 is explicitly set.
RESTORE_DATABASE_URL=
ALLOW_PRODUCTION_RESTORE=

# Operational alerts. ALERT_WEBHOOK_URL is optional; SMTP reuses the same
# transport as the day report when ALERT_TO/ALERT_FROM are configured.
ALERT_TO=
ALERT_FROM=
ALERT_WEBHOOK_URL=
SLOW_REQUEST_MS=2000

# External uptime monitor. Set this to the app base URL or directly to
# /api/health/ready. Render's Blueprint wires RENDER_EXTERNAL_URL automatically.
APP_HEALTH_URL=
HEALTH_MONITOR_TIMEOUT_MS=12000

# Explicit runtime mode. Render sets this to production in render.yaml.
NODE_ENV=development

# Where the day report should be sent, and how. With these unset the scheduled
# job prints the report instead of sending it.
REPORT_TO=
REPORT_FROM=
SMTP_URL=

# Port the API listens on (Render sets PORT itself at runtime).
PORT=5000

# TLS to the database. Leave empty for verified TLS. "no-verify" is only for a
# provider with a self-signed certificate; "off" is for local Postgres only.
PGSSL=

# Hosted databases count connections. Eight is ample for this application.
PGPOOL_MAX=8

# Optional translation/read providers.
GOOGLE_TRANSLATE_API_KEY=
ANTHROPIC_API_KEY=
