# Copy to .env and fill in. Only DATABASE_URL is required.

# Postgres. Locally this is your own server; in production it is the connection
# string from Neon — use the pooled one, which has "-pooler" in the host.
DATABASE_URL=postgres://user:password@localhost:5432/book

# Signs the login cookie. Required — the server will not start without it.
# Any long random string: `openssl rand -base64 32`.
SESSION_SECRET=

# Where the day report should be sent, and how. With these unset the scheduled
# job prints the report instead of sending it.
REPORT_TO=
REPORT_FROM=
SMTP_URL=

# Port the API listens on (Render sets this itself).
PORT=5000

# TLS to the database. Leave empty for a hosted one (Neon, Supabase, Render):
# the certificate is verified. "no-verify" for a provider with a self-signed
# certificate, "off" for a Postgres on your own machine with no TLS at all.
PGSSL=

# Optional. With a key set, sentences are read by Claude, which handles phrasing
# the built-in reader has never seen. Without one, the built-in reader is used —
# everything still works, it is just stricter about wording. Roughly a tenth of a
# cent per entry.
ANTHROPIC_API_KEY=
