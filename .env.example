# Copy to .env and fill in. Only DATABASE_URL is required.

# Postgres. Locally this is your own server; on Render it is filled in for you.
DATABASE_URL=postgres://user:password@localhost:5432/book

# Set this and every API call must send the same value as an x-book-token
# header. Leave it empty on your own machine. Real login arrives in Phase 4.
APP_TOKEN=

# Port the API listens on (Render sets this itself).
PORT=5000

# Set to "off" only for a local Postgres with no TLS.
PGSSL=
