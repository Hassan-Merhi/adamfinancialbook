# Copy to .env and fill in. DATABASE_URL and SESSION_SECRET are required.

# Postgres. Locally this is your own server; in production it is the connection
# string from Neon — use the pooled one, which has "-pooler" in the host.
DATABASE_URL=postgres://user:password@localhost:5432/book

# Signs the login cookie. Required and validated before any DB connection opens.
# Use at least 32 characters; `openssl rand -base64 32` is a good source.
SESSION_SECRET=

# Optional but recommended before enabling owner authenticator MFA. This encrypts
# TOTP secrets at rest. Keep it stable: changing it makes existing authenticator
# secrets unreadable. If unset, SESSION_SECRET is used as the encryption key.
MFA_ENCRYPTION_KEY=

# Explicit runtime mode. Render sets this to production in render.yaml.
NODE_ENV=development

# Where the day report should be sent, and how. With these unset the scheduled
# job prints the report instead of sending it.
REPORT_TO=
REPORT_FROM=
SMTP_URL=

# Port the API listens on (Render sets PORT itself at runtime).
PORT=5000

# TLS to the database. Leave empty for verified TLS. "no-verify" is only for a
# provider with a self-signed certificate; "off" is for local Postgres only.
PGSSL=

# Hosted databases count connections. Eight is ample for this application.
PGPOOL_MAX=8

# Optional translation/read providers.
GOOGLE_TRANSLATE_API_KEY=
ANTHROPIC_API_KEY=
