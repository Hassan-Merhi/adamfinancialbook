{
  "name": "adamfinancialbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/start.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/start.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:status": "tsx server/migration-status.ts",
    "db:integrity": "tsx server/integrity-check.ts",
    "db:setup": "tsx server/setup-db.ts",
    "test": "vitest run",
    "test:integration": "vitest run server/api.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test -- --passWithNoTests && npm run build",
    "user:add": "npm run db:migrate && tsx server/add-user.ts",
    "report:send": "npm run db:migrate && tsx server/send-report.ts",
    "backup": "npm run db:migrate && tsx server/backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.16.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
